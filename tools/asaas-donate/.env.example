# Copie para .env e preencha. O .env esta no .gitignore.

# --- Asaas -------------------------------------------------------------------
# Sandbox:   https://api-sandbox.asaas.com/v3
# Producao:  https://api.asaas.com/v3
# A chave precisa ser do MESMO ambiente da URL.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# Token que voce define no painel do Asaas em Integracoes > Webhooks.
# Ele volta no header asaas-access-token e e o que prova que a chamada
# veio mesmo do Asaas. Use algo longo e aleatorio.
ASAAS_WEBHOOK_TOKEN=

# UNDEFINED deixa o pagador escolher Pix, boleto ou cartao.
# Outras opcoes: PIX, BOLETO, CREDIT_CARD
ASAAS_BILLING_TYPE=UNDEFINED

# Dias que o link aceita pagamento depois de criado.
ASAAS_DUE_DATE_LIMIT_DAYS=1

# 1 = sem parcelamento. No cartao, o minimo por parcela do Asaas e R$ 5,00.
ASAAS_MAX_INSTALLMENTS=1

# --- Banco (os mesmos dados do config.lua) -----------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Crandoria

# --- Worker ------------------------------------------------------------------
# Porta do endpoint de webhook.
PORT=3000

# De quanto em quanto tempo procurar intencoes novas (ms).
POLL_INTERVAL_MS=5000

# Quantas intencoes processar por ciclo.
BATCH_SIZE=10

# Aparece no nome do link de pagamento que o doador ve.
SERVER_NAME=Crandoria
