[Unit]
Description=Agente privilegiado do painel CrandoriaOT
Documentation=file:///opt/crandoria/tools/painel/README.md
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/crandoria/tools/painel/agent/agent.py
Restart=always
RestartSec=5

# Precisa de root para falar com o Docker, mas nao precisa de mais nada:
# o resto abaixo tira tudo que da para tirar.
User=root
RuntimeDirectory=crandoria-painel
RuntimeDirectoryMode=0750
# Sem isto o systemd apaga e recria a pasta a cada restart do agente, e o
# container do painel - que monta a pasta, nao o socket - fica preso a
# pasta antiga, vazia: "agente fora do ar" ate recriar o container.
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Caminhos graváveis: o socket, os backups e /opt/crandoria, onde fica o
# config.lua. Liberar so o arquivo nao basta: a gravacao e atomica
# (temporario ao lado + rename), o que exige escrita na pasta - e um
# ReadWritePaths de arquivo avulso prenderia o agente ao inode. O caminho
# gravado continua fixo no codigo (CONFIG_PATH), nao vem do pedido.
ReadWritePaths=/run/crandoria-painel /opt/crandoria /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=painel-agent

[Install]
WantedBy=multi-user.target
