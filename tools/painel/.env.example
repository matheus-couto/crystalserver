# Copie para .env e preencha. O .env nao entra na imagem nem no git.

PORT=3100

# Assina o token anti-CSRF. Gere com:
#   openssl rand -base64 48
PANEL_SECRET=

# Banco: os mesmos valores do docker/.env
DB_HOST=database
DB_PORT=3306
DB_USER=crandoria
DB_PASS=
DB_NAME=crandoria

# Socket do agente privilegiado no host.
AGENT_SOCKET=/run/crandoria-painel/agent.sock

# Raiz do servidor, montada no container.
SERVER_ROOT=/srv/crystalserver

BACKUP_DB_DIR=/opt/crandoria/backups/db
BACKUP_SCRIPTS_DIR=/opt/crandoria/backups/scripts

# Falhas de login vao para ca, e o fail2ban observa este arquivo.
AUTH_LOG=/var/log/painel/auth.log
