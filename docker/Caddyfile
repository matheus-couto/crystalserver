# Caddy na frente de tudo. Ele obtem e renova o certificado do Let's Encrypt
# sozinho, entao nao ha certbot nem cron de renovacao.

{
	email matheus.couto@hotmail.com
}

# ---------------------------------------------------------------------------
# HTTP puro (porta 80)
#
# Existe por causa do cliente oficial: a URL de login esta gravada no binario
# como http://.../login.php, em HTTP. O comportamento padrao do Caddy seria
# redirecionar 80 -> 443, e o cliente nao segue redirecionamento no POST de
# login -- a tentativa simplesmente falharia.
#
# Por isso /login.php e atendido em HTTP e todo o resto e empurrado para HTTPS.
# ---------------------------------------------------------------------------
http://crandoriaot.com.br, http://151.244.40.110 {
	handle /login.php* {
		reverse_proxy myacc:80
	}

	handle /clientcreateaccount.php* {
		reverse_proxy myacc:80
	}

	handle {
		redir https://crandoriaot.com.br{uri} permanent
	}
}

# ---------------------------------------------------------------------------
# HTTPS (porta 443)
# ---------------------------------------------------------------------------
crandoriaot.com.br {
	encode gzip

	# Webhook do Asaas. Fica antes do bloco geral porque o handle e avaliado
	# na ordem em que aparece.
	handle /asaas/webhook* {
		reverse_proxy donate:3000
	}

	# Site e area de conta.
	handle {
		reverse_proxy myacc:80
	}

	header {
		# O MyAAC monta paginas com HTML e JS inline proprios; uma CSP
		# restritiva quebraria os templates, entao ela fica de fora.
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		X-XSS-Protection "1; mode=block"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# Um ano, obrigando HTTPS em visitas futuras. Fica so no bloco 443:
		# o navegador ignora HSTS vindo por HTTP, e o /login.php do cliente
		# precisa continuar atendendo em texto puro.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Nao anuncie a stack.
		-Server
		-X-Powered-By
	}

	# Nada aqui deve ser alcancavel de fora: arquivos de configuracao com
	# senha, dumps, backups e o diretorio .git. O Apache ja barra, mas
	# bloquear na borda evita que a requisicao chegue ao PHP.
	@proibido {
		path /config.local.php /config.php
		path /install/* "/install old/*"
		path /.git /.git/*
		path *.sql *.log *.dist *.bak *.old *.yml *.yaml *.lock
	}
	respond @proibido 404

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# ---------------------------------------------------------------------------
# Painel de administracao (subdominio proprio)
# ---------------------------------------------------------------------------
# Subdominio separado, e nao um caminho dentro do site, por dois motivos: o
# cookie de sessao do painel nunca e enviado junto com uma visita ao site, e
# um furo no MyAAC nao alcanca o painel.
painel.crandoriaot.com.br {
	encode gzip

	# Teto baixo de corpo: o maior envio legitimo e um script de alguns KB.
	# A excecao e o envio em fluxo, por onde entra o mapa (.otbm, ~130 MB);
	# o painel exige sessao e CSRF antes de ler o corpo e para em 512 MB.
	@envioArquivo path /scripts/enviar-arquivo
	@resto not path /scripts/enviar-arquivo
	request_body @resto {
		max_size 10MB
	}
	request_body @envioArquivo {
		max_size 600MB
	}

	handle {
		reverse_proxy painel:3100 {
			# O painel confia em exatamente um salto para descobrir o IP de
			# quem chamou. Sem estes cabecalhos o bloqueio por tentativa veria
			# todo mundo como o proprio Caddy e travaria os dois de uma vez.
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}

	log {
		output file /var/log/caddy/painel.log
		format console
	}
}
